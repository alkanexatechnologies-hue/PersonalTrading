{
  "name": "nsa-intraday-assistant",
  "version": "0.1.0",
  "description": "Intraday trading assistant for Indian (NSE) stocks - live data, technical indicators, signal engine, and backtesting.",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch backend/server.ts",
    "start": "tsx backend/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"backend/**/*.test.ts\"",
    "backtest:oi": "tsx scripts/oi-backtest.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "nodemailer": "^10.0.3",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.1",
    "puppeteer-core": "^25.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}

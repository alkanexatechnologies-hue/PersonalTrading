# Copy to .env for local development, or set these as Render Environment
# Variables in production. Never commit real values — this file must only
# ever contain empty placeholders.

# Dashboard login (single admin account, backend/auth/credentials.ts).
# Leave both empty locally to get an auto-generated password printed to the
# console; set both in Render so the admin login survives every redeploy.
LOGIN_USER=
LOGIN_PASS=

# Groww market-data / broker session (backend/data/growwProvider.ts).
GROWW_ACCESS_TOKEN=

# Dhan historical-data client (backend/data/dhanConfig.ts).
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=

# Telegram alerts (backend/integrations/telegramProvider.ts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP, for emailing rotated admin credentials (backend/auth/mailer.ts).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI narration (backend/agent/narrationAgent.ts). Omit to fall back to
# template-based narration with no external calls.
ANTHROPIC_API_KEY=

# Server port. Render sets this automatically — leave empty on Render.
PORT=

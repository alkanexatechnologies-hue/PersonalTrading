# Copy to .env for local development, or set these as Render Environment
# Variables in production. Never commit real values — this file must only
# ever contain empty placeholders.

# Dashboard login (single admin account, backend/auth/credentials.ts).
# Leave both empty locally to get an auto-generated password printed to the
# console; set both in Render so the admin login survives every redeploy.
LOGIN_USER=
LOGIN_PASS=

# Groww market-data / broker session (backend/data/growwProvider.ts).
GROWW_ACCESS_TOKEN=

# Dhan historical-data client (backend/data/dhanConfig.ts).
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=

# Telegram alerts (backend/integrations/telegramProvider.ts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP, for emailing rotated admin credentials (backend/auth/mailer.ts).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI narration (backend/agent/narrationAgent.ts). Omit to fall back to
# template-based narration with no external calls.
ANTHROPIC_API_KEY=

# External market-data provider for the "09:10 Market & Global Sentiment" desk
# ONLY (global indices, USDINR/DXY, US 10Y, Brent/WTI, gold, CBOE VIX). This does
# NOT feed any Indian trading signal — NIFTY/BANKNIFTY/stocks/options stay on
# Dhan/Groww. No key ⇒ those external fields show DATA UNAVAILABLE (never faked).
# Read only from the server env — never exposed to the browser or logged.
MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_API_KEY=

# Optional: a JSON endpoint for FII index-futures positioning (date-wise long/
# short). Without it, and without an NSE participant-OI source, the FII section
# shows DATA UNAVAILABLE — FII data is never fabricated or inferred.
FII_DATA_URL=

# Server port. Render sets this automatically — leave empty on Render.
PORT=

# OI Analysis module (Market Command → OI Analysis). Read-only OI intelligence:
# "OI Movement" (what is changing now) + "OI Summary" (what it indicates). Off by
# default; when off the screen shows a Test-Zone banner. Never places any order.
OI_ANALYSIS_ENABLED=false
